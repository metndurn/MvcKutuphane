@model MvcKutuphane.Models.Entity.Yazarlar
@{
    ViewBag.Title = "YazarEkle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*bu derste html helperlar kullanıldı dıkkat et bu kullanıslıdır*@
<br />
<h2>Yazar İşlemleri</h2>
<form class="form-group" method="post">
    <br />
    <div style="margin-bottom:15px">
        <label>Yazar Adı</label>
        @Html.TextBoxFor(y => y.Ad, new { @class = "form-control" })
    </div>
    <div style="margin-bottom:15px">
        <label>Yazar Soyadı</label>
        @Html.TextBoxFor(y => y.Soyad, new { @class = "form-control" })
    </div>
    <div style="margin-bottom:15px">
        <label>Yazar Detay</label>
        @Html.TextAreaFor(y => y.Detay, new { @class = "form-control" })
    </div>
    <div style="margin-top:15px">
        <button class="btn btn-primary" id="btn1">Yazar Ekle</button>
    </div>
</form>

