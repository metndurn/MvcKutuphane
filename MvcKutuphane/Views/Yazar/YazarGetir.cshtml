@*Güncellenecek veriyi model olarak aldık*@
@model MvcKutuphane.Models.Entity.Yazarlar
@{
    ViewBag.Title = "YazarGetir";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<h2 class="text-center">Yazar Güncelle</h2>
<hr />
@using (Html.BeginForm("YazarGuncelle", "Yazar", FormMethod.Post))
{
    <div style="margin-bottom:15px"></div>
    <div class="form-group">
        <div style="margin-bottom:15px">
            <label>Yazar Id</label>
            @Html.TextBoxFor(k => k.Id, new { @class = "form-control" })
        </div>
        <div style="margin-bottom:15px">
            <label>Yazar Adı</label>
            @Html.TextBoxFor(k => k.Ad, new { @class = "form-control" })
        </div>
        <div style="margin-bottom:15px">
            <label>Yazar Soyadı</label>
            @Html.TextBoxFor(k => k.Soyad, new { @class = "form-control" })
        </div>
        <div style="margin-bottom:15px">
            <label>Yazar Detay Bilgileri</label>
            @Html.TextBoxFor(k => k.Detay, new { @class = "form-control" })
        </div>
    </div>
    <div>
        <button class="btn btn-warning">Yazar Bilgilerini Güncelle</button>
    </div>
}

